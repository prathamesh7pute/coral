{
  "name": "coral",
  "description": "Node JS framework to dynamically create REST application with express and mongoose Models",
  "version": "0.5.4",
  "author": {
    "name": "Prathamesh Satpute",
    "email": "prathamesh.satpute@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/coral.js",
  "types": "./lib/coral.d.ts",
  "exports": {
    ".": {
      "types": "./lib/coral.d.ts",
      "default": "./lib/coral.js"
    }
  },
  "keywords": [
    "rest",
    "mongoose",
    "express",
    "node"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "prepare": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prathamesh7pute/coral.git"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "mongodb-memory-server": "^11.0.1",
    "mongoose": "^9.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}