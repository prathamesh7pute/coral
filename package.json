{
  "name": "coral",
  "description": "Node JS framework to dynamically create REST application with express and mongoose Models",
  "version": "0.5.4",
  "author": {
    "name": "Prathamesh Satpute",
    "email": "prathamesh.satpute@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/coral.js",
  "types": "./lib/coral.d.ts",
  "exports": {
    ".": {
      "types": "./lib/coral.d.ts",
      "default": "./lib/coral.js"
    }
  },
  "keywords": [
    "rest",
    "mongoose",
    "express",
    "node"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "prepare": "npm run build",
    "test": "npm run lint && npm run build && NODE_OPTIONS='--import tsx' c8 mocha --exit --extensions ts,js ./test/**/*.spec.ts",
    "test:watch": "mocha --watch ./test/**/*.spec.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prathamesh7pute/coral.git"
  },
  "dependencies": {
    "express": "^4.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.19",
    "@types/should": "^11.2.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "c8": "^10.1.2",
    "eslint": "^9.20.1",
    "espree": "^11.1.0",
    "globals": "^15.15.0",
    "mocha": "^10.0.0",
    "mongodb-memory-server": "^10.2.0",
    "mongoose": "^6.6.2",
    "should": "^13.2.3",
    "supertest": "^6.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}