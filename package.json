{
  "name": "coral",
  "description": "A lightweight Node.js framework designed to dynamically generate RESTful API routes for Express applications using Mongoose models",
  "version": "1.0.0",
  "author": {
    "name": "Prathamesh Satpute",
    "email": "prathamesh.satpute@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rest",
    "mongoose",
    "express",
    "node"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "prepare": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prathamesh7pute/coral.git"
  },
  "bugs": {
    "url": "https://github.com/prathamesh7pute/coral/issues"
  },
  "homepage": "https://github.com/prathamesh7pute/coral#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "mongoose": "^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "mongodb-memory-server": "^11.0.1",
    "mongoose": "^9.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
