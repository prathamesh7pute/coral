{
  "name": "coral",
  "description": "A lightweight Node.js framework designed to dynamically generate RESTful API routes for Express applications using Mongoose models",
  "version": "1.0.5",
  "author": {
    "name": "Prathamesh Satpute",
    "email": "prathamesh.satpute@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rest",
    "mongoose",
    "express",
    "node"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:packages": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:packages": "npm run typecheck --workspaces --if-present",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:ci": "biome ci .",
    "check:packages": "npm run check:ci --workspaces --if-present",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:packages": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prathamesh7pute/coral.git"
  },
  "bugs": {
    "url": "https://github.com/prathamesh7pute/coral/issues"
  },
  "homepage": "https://github.com/prathamesh7pute/coral#readme",
  "dependencies": {},
  "peerDependencies": {
    "express": "^5.0.0",
    "mongoose": "^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "express": "^5.0.0",
    "mongodb-memory-server": "^11.0.1",
    "mongoose": "^9.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
